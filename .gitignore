node_modules/
dist/
coverage/
*.log

# Expo
.expo/
apps/mobile/ios/
apps/mobile/android/
# Next
.next/
.open-next/

# Cloudflare
.wrangler/
.dev.vars

# local machine-specific agent notes
CLAUDE.local.md

# agent skills installed by `npx skills add` — tooling, not source
.agents/

.DS_Store

secrets/

.claude

# Base photography for the generated catalogue — ~82 MB, regenerable.
# See design-system/models/README.md for the roster and where the originals live.
design-system/models/*.png

# Cached catalogue art for the store screenshots, refetched by
# tools/store-screenshots/generate.py. The bucket is the source.
screenshots/store/.art/

# TypeScript incremental build state. A local cache of what tsc already
# checked, rewritten by every `bun run typecheck` — it dirties the tree on a
# command that changes nothing.
*.tsbuildinfo

# full-resolution UGC persona renders; the committed .jpg mirrors are what the slides use
design-system/ugc-model/_fullres/

# An empty `{"expo":{}}` that expo/eas tooling drops at the repo root when it is
# run from here instead of from apps/mobile. The app's real manifest is
# apps/mobile/app.json; this one is read by nothing and keeps coming back.
/app.json

# Pairing identity that go-ios writes into whatever directory it is run from.
# Holds a private key; it has no business in a commit.
selfIdentity.plist

# Apple signing material.
*.p8
*.p12
*.mobileprovision
