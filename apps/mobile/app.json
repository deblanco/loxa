{
  "expo": {
    "name": "Loxa",
    "slug": "loxa",
    "scheme": "loxa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.blankhexadecimal.loxa",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Loxa uses the camera to take the photo it restyles."
      }
    },
    "android": {
      "package": "com.blankhexadecimal.loxa",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Loxa needs your photo library so you can pick the photo to restyle.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Loxa saves your generated looks to your camera roll.",
          "photosPermission": "Loxa needs your photo library so you can pick the photo to restyle.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#faf8f5"
        }
      ],
      "expo-sharing",
      "expo-image",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "644bbd57-8ad7-4384-a38e-710700e98944"
      }
    },
    "owner": "deblancos-team"
  }
}
