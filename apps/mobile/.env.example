# Copy to .env.local for simulator development.
#
# localhost is unreachable from a physical device — use `bun run dev:api:lan`
# and the machine's LAN address there instead.
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Where the generated style previews are served from — the public R2 domain for
# the loxa-assets bucket. Unset is a supported state: the strip and the plate
# fall back to the hatched placeholder rather than to broken images.
EXPO_PUBLIC_ASSETS_URL=https://loxa-assets.blankhexadecimal.com
