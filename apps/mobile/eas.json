{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://loxa-api.blankhexadecimal.com",
        "EXPO_PUBLIC_ASSETS_URL": "https://loxa-assets.blankhexadecimal.com",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "test_GcvstKHIFrxuWwTzkFOeLWDTaYb"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://loxa-api.blankhexadecimal.com",
        "EXPO_PUBLIC_ASSETS_URL": "https://loxa-assets.blankhexadecimal.com",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "test_GcvstKHIFrxuWwTzkFOeLWDTaYb"
      }
    },
    "testflight": {
      "extends": "production",
      // Every build on this profile is a TestFlight upload, and Apple refuses a
      // build number it has already seen. `appVersionSource: remote` means EAS
      // owns the counter, so this is the only place it can be told to move.
      // Boolean, not "buildNumber": the schema rejects the string form here.
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://loxa-api.blankhexadecimal.com",
        "EXPO_PUBLIC_ASSETS_URL": "https://loxa-assets.blankhexadecimal.com",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_FwsbanTUmkfQtcsxnUWreybJlnv"
      }
    },
    "production": {
      // Same reason as the testflight profile: `appVersionSource: remote` means
      // EAS owns the build counter, and Apple refuses a build number it has
      // already seen. Without this a production build reuses the last number
      // the testflight profile minted and the upload is rejected.
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://loxa-api.blankhexadecimal.com",
        "EXPO_PUBLIC_ASSETS_URL": "https://loxa-assets.blankhexadecimal.com",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_FwsbanTUmkfQtcsxnUWreybJlnv"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "appleId": "hola@blankhexadecimal.com",
        "ascAppId": "6807078260",
        "appleTeamId": "K579SJ8947"
      }
    },
    "production": {
      "ios": {
        "appleId": "hola@blankhexadecimal.com",
        "ascAppId": "6807078260",
        "appleTeamId": "K579SJ8947"
      }
    }
  }
}
