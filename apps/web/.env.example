# Copy to .env.local for `next dev`, and set the same value in the build
# environment — NEXT_PUBLIC_* is inlined at build time, not read at runtime.

# Where the generated style previews are served from — the public R2 domain for
# the loxa-assets bucket, the same one the app uses. Unset is a supported state:
# the style grid falls back to the hatched placeholder rather than to broken
# images.
NEXT_PUBLIC_ASSETS_URL=https://loxa-assets.blankhexadecimal.com
