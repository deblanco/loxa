{
  "name": "@loxa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:lan": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute loxa --local --file=schema.sql",
