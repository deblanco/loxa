    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@loxa/shared": "workspace:*",
    "hono": "^4.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^4.20250816.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "vitest": "^4.1.10",
    "wrangler": "^4.30.0"
  }
}
